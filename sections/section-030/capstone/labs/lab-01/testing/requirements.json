{
  "context": "kind-astro-ats-033-lab-030-capstone-01",
  "resources": [
    {
      "kind": "pod",
      "name": "node-local-server",
      "namespace": "starfleet",
      "state": "pod",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "node-local-server",
          "namespace": "starfleet"
        },
        "spec": {
          "hostNetwork": true,
          "containers": [
            {
              "name": "web",
              "image": "docker.io/library/python:3.13-alpine",
              "command": [
                "python",
                "-m",
                "http.server",
                "19090",
                "--bind",
                "127.0.0.1"
              ]
            }
          ]
        }
      }
    },
    {
      "kind": "service",
      "name": "probe-debug",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "probe-debug",
          "namespace": "starfleet"
        },
        "spec": {
          "type": "ClusterIP",
          "selector": {
            "app": "probe",
            "release": "probe"
          }
        }
      }
    },
    {
      "kind": "service",
      "name": "probe-public",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "probe-public",
          "namespace": "starfleet"
        },
        "spec": {
          "type": "NodePort",
          "selector": {
            "app": "probe",
            "release": "probe"
          },
          "externalTrafficPolicy": "Local"
        }
      }
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "node-local-server",
        "--",
        "python",
        "-c",
        "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:19090/',timeout=3).status)"
      ],
      "equals": "200"
    },
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "shuttle",
        "--",
        "wget",
        "-qO-",
        "-T",
        "3",
        "http://probe-debug.starfleet/"
      ],
      "contains": [
        "version=v1"
      ]
    },
    {
      "args": [
        "kubectl",
        "get",
        "node",
        "astro-ats-033-lab-030-capstone-01-worker",
        "-o",
        "jsonpath={.status.conditions[?(@.type==\"Ready\")].status}"
      ],
      "equals": "True"
    }
  ]
}
