{
  "context": "kind-astro-ats-033-lab-040-02-01",
  "resources": [
    {
      "kind": "pod",
      "name": "no-delete",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "no-delete",
          "namespace": "starfleet"
        },
        "spec": {
          "restartPolicy": "Never",
          "securityContext": {
            "seccompProfile": {
              "type": "Localhost",
              "localhostProfile": "profiles/block-delete.json"
            }
          },
          "containers": [
            {
              "name": "shell",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ]
            }
          ]
        }
      },
      "state": "pod"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "no-delete",
        "--",
        "sh",
        "-c",
        "echo kept > /tmp/keep; cat /tmp/keep"
      ],
      "equals": "kept"
    },
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "no-delete",
        "--",
        "sh",
        "-c",
        "rm /tmp/keep"
      ],
      "denied": true,
      "failure_markers": [
        "operation not permitted"
      ]
    }
  ]
}
