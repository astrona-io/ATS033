#include <tunables/global>

profile k8s-deny-etc-write flags=(attach_disconnected) {
  #include <abstractions/base>

  network,
  capability,
  # Let the container runtime (runc) stop the container.
  signal (receive) peer=runc,

  # Read, map and run every file.
  /** mrix,
  # Write only in these directories. Nothing allows a write under /etc.
  /{dev,proc,run,tmp,var}/** rwk,
}
