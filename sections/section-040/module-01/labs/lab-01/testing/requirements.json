{
  "context": "kind-astro-ats-033-lab-040-01-01",
  "cluster": "astro-ats-033-lab-040-01-01",
  "namespace": "starfleet-033-040-01-01",
  "resources": [
    {
      "kind": "pod",
      "name": "restricted-reader",
      "namespace": "starfleet-033-040-01-01",
      "expected": {
        "metadata": {
          "name": "restricted-reader",
          "namespace": "starfleet-033-040-01-01"
        },
        "spec": {
          "restartPolicy": "Never",
          "containers": [
            {
              "name": "reader",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ]
            }
          ]
        }
      },
      "state": "pod"
    },
    {
      "kind": "pod",
      "name": "restricted-reader",
      "namespace": "starfleet-033-040-01-01",
      "expected": {
        "metadata": {
          "name": "restricted-reader",
          "namespace": "starfleet-033-040-01-01"
        },
        "spec": {
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 1000,
            "runAsGroup": 1000,
            "fsGroup": 1000
          }
        }
      },
      "outcome": "reader-identity"
    },
    {
      "kind": "pod",
      "name": "restricted-reader",
      "namespace": "starfleet-033-040-01-01",
      "expected": {
        "metadata": {
          "name": "restricted-reader",
          "namespace": "starfleet-033-040-01-01"
        },
        "spec": {
          "securityContext": {
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          }
        }
      },
      "outcome": "reader-seccomp"
    },
    {
      "kind": "pod",
      "name": "restricted-reader",
      "namespace": "starfleet-033-040-01-01",
      "expected": {
        "metadata": {
          "name": "restricted-reader",
          "namespace": "starfleet-033-040-01-01"
        },
        "spec": {
          "containers": [
            {
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              }
            }
          ]
        }
      },
      "outcome": "reader-container-hardening"
    },
    {
      "kind": "pod",
      "name": "restricted-reader",
      "namespace": "starfleet-033-040-01-01",
      "expected": {
        "metadata": {
          "name": "restricted-reader",
          "namespace": "starfleet-033-040-01-01"
        }
      },
      "outcome": "reader-scratch-volume"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet-033-040-01-01",
        "exec",
        "restricted-reader",
        "--",
        "id",
        "-u"
      ],
      "equals": "1000",
      "outcome": "reader-identity"
    },
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet-033-040-01-01",
        "exec",
        "restricted-reader",
        "--",
        "sh",
        "-c",
        "printf allowed > /scratch/result; cat /scratch/result"
      ],
      "equals": "allowed",
      "outcome": "reader-scratch-volume"
    },
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet-033-040-01-01",
        "exec",
        "restricted-reader",
        "--",
        "sh",
        "-c",
        "printf denied > /root-file"
      ],
      "denied": true,
      "failure_markers": [
        "read-only file system"
      ],
      "outcome": "reader-container-hardening"
    }
  ]
}
